{
  "name": "@carmaclouds/core",
  "version": "2.6.1",
  "description": "Core utilities and types shared across CarmaClouds packages",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./cache": {
      "import": "./dist/cache/index.js",
      "types": "./dist/cache/index.d.ts"
    },
    "./supabase": {
      "import": "./dist/supabase/index.js",
      "types": "./dist/supabase/index.d.ts"
    },
    "./supabase/config.js": "./src/supabase/config.js",
    "./types": {
      "import": "./dist/types/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./common/*": "./src/common/*",
    "./modules/*": "./src/modules/*",
    "./browser.js": "./src/browser.js",
    "./ir": {
      "import": "./dist/ir/index.js",
      "types": "./dist/ir/index.d.ts"
    },
    "./render": {
      "import": "./dist/render/index.js",
      "types": "./dist/render/index.d.ts"
    },
    "./src/*": "./src/*"
  },
  "files": [
    "dist",
    "src",
    "!src/ir/__fixtures__"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CarmaNayeli/carmaclouds.git",
    "directory": "packages/core"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "release": "node scripts/publish.mjs",
    "test": "echo \"No tests yet\"",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "carmaclouds",
    "dicecloud",
    "vtt",
    "character-sheet"
  ],
  "license": "MIT",
  "devDependencies": {
    "linkedom": "^0.18.12",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0"
  }
}
