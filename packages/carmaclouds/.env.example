# Mozilla Add-on (AMO) API credentials for signing the Firefox extension.
# Get these from: https://addons.mozilla.org/developers/addon/api/key/
#
# Copy this file to ".env" and fill in your real values. The ".env" file is
# gitignored and will never be committed. Then run:  .\sign-firefox.ps1

# JWT issuer — looks like "user:12345:67"
WEB_EXT_API_KEY=user:XXXXX:XX

# JWT secret — long hex string
WEB_EXT_API_SECRET=your-secret-here
