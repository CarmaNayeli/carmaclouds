{
  "name": "@carmaclouds/carmaclouds",
  "version": "2.8.4",
  "description": "CarmaClouds: Unified DiceCloud integration for Roll20, Owlbear Rodeo, and Foundry VTT",
  "type": "module",
  "scripts": {
    "build": "node build.js",
    "dev": "node build.js --watch",
    "lint:firefox": "web-ext lint --source-dir=dist",
    "sign:firefox": "web-ext sign --source-dir=dist --artifacts-dir=../../releases --channel=unlisted"
  },
  "keywords": [
    "carmaclouds",
    "dicecloud",
    "roll20",
    "owlbear",
    "foundry",
    "vtt",
    "browser-extension"
  ],
  "author": "Dice Cat",
  "license": "MIT",
  "devDependencies": {
    "archiver": "^7.0.1",
    "web-ext": "^10.4.0"
  }
}
